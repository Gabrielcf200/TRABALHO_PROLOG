# Copie este arquivo para app/.env e cole sua chave.
# Chave gratuita do Gemini: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Alias que aponta sempre para o Flash mais novo. Para ver as opções da sua chave:
#   python app/llm.py --modelos
LLM_MODEL=gemini-flash-latest

# Opcional: caminho do swipl, se ele não estiver no PATH.
# SWIPL=C:\Program Files\swipl\bin\swipl.exe
